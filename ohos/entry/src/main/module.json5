{
  module: {
    name: "entry",
    type: "entry",
    description: "$string:module_desc",
    mainElement: "EntryAbility",
    deviceTypes: ["phone"],
    deliveryWithInstall: true,
    installationFree: false,
    pages: "$profile:main_pages",
    // 华为账号 Kit（一键登录）所需的应用标识：AppGallery Connect → 我的项目 → 应用信息 → Client ID
    // 需同时满足：AGC 应用已开通「华为账号」服务；包名（com.mpr.chaincode）
    // 与签名证书指纹已在 AGC 登记，否则登录返回 1001502002（应用未授权）。
    metadata: [
      {
        name: "client_id",
        value: "6917616558575214481",
      },
    ],
    // 微信 OpenSDK：weixin 用于判断微信是否安装，wxopensdk 用于跳转微信
    // （二者均为官方《鸿蒙应用开发手册》1.4 节要求，勿删；去掉 wxopensdk 会让 SDK 改走
    //  startAbility 通道，而 fluwx 5.7.x 在 OHOS 未绑定 eventHandler，回包会被静默丢弃）
    // qqopenapi / https：QQ 鸿蒙版 SDK（tencent_kit）要求，用于判断 QQ/浏览器是否可用
    // 及接收 QQ 授权回调（见下方 skills 中的 qqopenapi 配置）
    querySchemes: ["weixin", "wxopensdk", "qqopenapi", "https"],
    abilities: [
      {
        name: "EntryAbility",
        srcEntry: "./ets/entryability/EntryAbility.ets",
        description: "$string:EntryAbility_desc",
        icon: "$media:icon",
        label: "$string:EntryAbility_label",
        startWindowIcon: "$media:icon",
        startWindowBackground: "$color:start_window_background",
        exported: true,
        skills: [
          {
            entities: ["entity.system.home"],
            actions: ["action.system.home"],
          },
          {
            // 微信授权回调：微信通过该 action 拉起本应用并回传登录结果
            entities: ["entity.system.browsable"],
            actions: ["wxentity.action.open"],
          },
          {
            // QQ 授权回调（tencent_kit 官方鸿蒙接入要求）：
            // scheme 固定 qqopenapi，host 必须是 QQ 互联 AppID，
            // pathRegex 覆盖授权(auth)与分享(share)两种回调，
            // linkFeature=Login 表示接收登录回传。
            // ⚠️ host 要与 pubspec.yaml 的 tencent_kit.app_id、
            //    lib/common/constants.dart 的 qqAppId 保持一致。
            entities: ["entity.system.browsable"],
            actions: ["ohos.want.action.viewData"],
            uris: [
              {
                scheme: "qqopenapi",
                host: "1106531844",
                pathRegex: "\\b(auth|share)\\b",
                linkFeature: "Login",
              },
            ],
          },
        ],
      },
    ],
    requestPermissions: [
      {
        name: "ohos.permission.INTERNET",
        reason: "$string:network_reason",
        usedScene: {
          abilities: ["EntryAbility"],
          when: "inuse",
        },
      },
      {
        name: "ohos.permission.CAMERA",
        reason: "$string:camera_reason",
        usedScene: {
          abilities: ["EntryAbility"],
          when: "inuse",
        },
      },
      {
        name: "ohos.permission.GET_NETWORK_INFO",
        reason: "$string:network_info_reason",
        usedScene: {
          abilities: ["EntryAbility"],
          when: "inuse",
        },
      },
    ],
  },
}
