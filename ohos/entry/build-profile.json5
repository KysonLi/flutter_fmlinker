{
  "apiType": 'stageMode',
  "buildOption": {
    "externalNativeOptions": {
      "abiFilters": ["arm64-v8a", "x86_64"]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS",
      "config": {
        "buildOption": {
          // ArkTS 混淆（arkGuard），默认关闭。
          // 启用：把 enable 改为 true，并完成一次完整真机回归（插件类名/反射相关需重点验证），
          // 保留规则见 ohos/entry/obfuscation-rules.txt
          "arkOptions": {
            "obfuscation": {
              "ruleOptions": {
                "enable": false,
                "files": ["./obfuscation-rules.txt"]
              }
            }
          }
        }
      }
    },
    {
      "name": "ohosTest",
    }
  ]
}
